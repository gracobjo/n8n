      "id": "set-backup-001",
      "name": "Rutas backup",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "command": "=powershell -NoProfile -File \"C:\\Users\\chuwi\\Documents\\n8n\\workflows\\backup-carpeta.ps1\" -SourcePath \"{{ $json.sourcePath }}\" -BackupDir \"{{ $json.backupDir }}\" -Mode {{ $json.mode }} -FullEveryDays {{ $json.fullEveryDays }}"
      },
      "id": "exec-zip-001",
      "name": "Ejecutar backup",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Rutas backup').item.json;\nconst out = $input.first().json;\nconst stdout = String(out.stdout ?? out ?? '');\nconst lines = stdout\n  .split(/\\r?\\n/)\n  .map((l) => l.replace(/^\\uFEFF/, '').trim())\n  .filter(Boolean);\n\nlet parsed = null;\nfor (let i = lines.length - 1; i >= 0; i--) {\n  const line = lines[i];\n  if (!line.startsWith('{')) continue;\n  try {\n    parsed = JSON.parse(line);\n    break;\n  } catch {\n    /* siguiente */\n  }\n}\n\nif (!parsed || !parsed.status) {\n  throw new Error(`No se pudo parsear JSON del backup. stdout: ${stdout}. stderr: ${out.stderr ?? ''}`);\n}\n\nconst zipPath = parsed.zipPath ? String(parsed.zipPath).trim() : '';\nconst zipPathPosix = zipPath ? zipPath.replace(/\\\\/g, '/') : '';\nconst created = parsed.status === 'created' && Boolean(zipPath);\n\nreturn [\n  {\n    json: {\n      sourcePath: cfg.sourcePath,\n      backupDir: cfg.backupDir,\n      daysToKeep: Number(cfg.daysToKeep ?? 7),\n      modeRequested: cfg.mode,\n      mode: parsed.mode ?? 'none',\n      status: parsed.status,\n      reason: parsed.reason ?? '',\n      message: parsed.message ?? '',\n      contentHash: parsed.contentHash ?? '',\n      fileCount: Number(parsed.fileCount ?? 0),\n      sourceFileCount: Number(parsed.sourceFileCount ?? 0),\n      zipPath,\n      zipPathPosix,\n      fileName: parsed.fileName ?? (zipPath ? zipPath.split(/[/\\\\]/).pop() : ''),\n      lastFullZip: parsed.lastFullZip ?? '',\n      created,\n      chatId: cfg.chatId,\n      ahora: new Date().toLocaleString('es-ES', { timeZone: 'Europe/Madrid' }),\n    },\n  },\n];"
      },
      "id": "code-parse-zip-001",
      "name": "Parsear resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-created",
              "leftValue": "={{ $json.created }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-created-001",
      "name": "IF ZIP creado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.zipPathPosix }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "read-zip-001",
      "name": "Leer ZIP disco",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [1100, 180]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ $('Parsear resultado').item.json.fileName }}",
        "driveId": {
          "__rl": true,
          "mode": "id",
          "value": "root"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "18NmjbymVBtT4BTQuIHUg-7kEhFBswO2r"
        },
        "options": {}
      },
      "id": "gdrive-upload-001",
      "name": "Subir a Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1320, 180],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REEMPLAZAR_ID_CREDENCIAL",
          "name": "Google Drive account"
        }
      },
      "disabled": false
    },
    {
      "parameters": {
        "command": "=powershell -NoProfile -File \"C:\\Users\\chuwi\\Documents\\n8n\\workflows\\rotar-backups.ps1\" -BackupDir \"{{ $('Parsear resultado').item.json.backupDir }}\" -DaysToKeepLegacy {{ $('Parsear resultado').item.json.daysToKeep }}"
      },
      "id": "exec-rotate-001",
      "name": "Rotacion retencion",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1540, 180]
    },
    {
      "parameters": {
        "sendTo": "tu-correo@gmail.com",
        "subject": "=💾 Backup {{ $('Parsear resultado').item.json.mode }} — {{ $('Parsear resultado').item.json.fileName }}",
        "emailType": "text",
        "message": "=Copia de seguridad completada.\n\nEstado: {{ $('Parsear resultado').item.json.status }}\nModo: {{ $('Parsear resultado').item.json.mode }} (pedido: {{ $('Parsear resultado').item.json.modeRequested }})\nOrigen: {{ $('Parsear resultado').item.json.sourcePath }}\nZIP: {{ $('Parsear resultado').item.json.zipPath }}\nArchivos en ZIP: {{ $('Parsear resultado').item.json.fileCount }} / origen {{ $('Parsear resultado').item.json.sourceFileCount }}\nHash contenido: {{ $('Parsear resultado').item.json.contentHash }}\nRetención legacy (días): {{ $('Parsear resultado').item.json.daysToKeep }}\nHora: {{ $('Parsear resultado').item.json.ahora }}\n\nRotación:\n{{ $json.stdout || $json }}\n\nGoogle Drive: {{ $('Subir a Google Drive').isExecuted ? ($('Subir a Google Drive').item.json.webViewLink || ('https://drive.google.com/open?id=' + $('Subir a Google Drive').item.json.id)) : 'n/d' }}",
        "options": {}
      },
      "id": "gmail-backup-001",
