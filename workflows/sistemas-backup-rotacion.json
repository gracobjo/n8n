{
  "name": "Sistemas — Backup local + rotación",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "sched-backup-001",
      "name": "Schedule 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "sourcePath",
              "value": "C:\\Users\\chuwi\\n8n-backup-origen",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "backupDir",
              "value": "C:\\Users\\chuwi\\n8n-backups",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "daysToKeep",
              "value": 7,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "set-backup-001",
      "name": "Rutas backup",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "command": "=powershell -NoProfile -File \"C:\\Users\\chuwi\\Documents\\n8n\\workflows\\backup-carpeta.ps1\" -SourcePath \"{{ $json.sourcePath }}\" -BackupDir \"{{ $json.backupDir }}\""
      },
      "id": "exec-zip-001",
      "name": "Crear ZIP",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Rutas backup').item.json;\nconst out = $input.first().json;\nconst stdout = String(out.stdout ?? out ?? '');\nconst lines = stdout\n  .split(/\\r?\\n/)\n  .map((l) => l.replace(/^\\uFEFF/, '').trim().replace(/^['\"]|['\"]$/g, ''))\n  .filter(Boolean);\nlet zipPath = lines.reverse().find((l) => /\\.zip$/i.test(l)) || '';\nzipPath = zipPath.trim();\n\nif (!zipPath || !/\\.zip$/i.test(zipPath)) {\n  throw new Error(\n    `No se obtuvo ruta ZIP válida. stdout: ${stdout}. stderr: ${out.stderr ?? ''}`,\n  );\n}\n\nconst fileName = zipPath.split(/[/\\\\]/).pop();\nconst zipPathPosix = zipPath.replace(/\\\\/g, '/');\n\nreturn [\n  {\n    json: {\n      sourcePath: cfg.sourcePath,\n      backupDir: cfg.backupDir,\n      daysToKeep: Number(cfg.daysToKeep ?? 7),\n      zipPath,\n      zipPathPosix,\n      fileName,\n      ahora: new Date().toLocaleString('es-ES'),\n    },\n  },\n];"
      },
      "id": "code-parse-zip-001",
      "name": "Parsear ruta ZIP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.zipPathPosix }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "read-zip-001",
      "name": "Leer ZIP disco",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [880, 300],
      "notes": "File(s) Selector = zipPathPosix (con / y sin espacio). Requiere N8N_RESTRICT_FILE_ACCESS_TO con n8n-backups."
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ $('Parsear ruta ZIP').item.json.fileName }}",
        "driveId": {
          "__rl": true,
          "mode": "id",
          "value": "root"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "18NmjbymVBtT4BTQuIHUg-7kEhFBswO2r"
        },
        "options": {}
      },
      "id": "gdrive-upload-001",
      "name": "Subir a Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1100, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REEMPLAZAR_ID_CREDENCIAL",
          "name": "Google Drive account"
        }
      },
      "disabled": false,
      "notes": "Debe estar EN la cadena (después de Leer ZIP). Parent Drive By ID=root; Folder=18Nmjbym…. Activate si aparece disabled."
    },
    {
      "parameters": {
        "command": "=powershell -NoProfile -File \"C:\\Users\\chuwi\\Documents\\n8n\\workflows\\rotar-backups.ps1\" -BackupDir \"{{ $('Parsear ruta ZIP').item.json.backupDir }}\" -DaysToKeep {{ $('Parsear ruta ZIP').item.json.daysToKeep }}"
      },
      "id": "exec-rotate-001",
      "name": "Rotacion +7 dias",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "sendTo": "tu-correo@gmail.com",
        "subject": "=💾 Backup OK — {{ $('Parsear ruta ZIP').item.json.fileName }}",
        "emailType": "text",
        "message": "=Copia de seguridad completada.\n\nOrigen: {{ $('Parsear ruta ZIP').item.json.sourcePath }}\nZIP: {{ $('Parsear ruta ZIP').item.json.zipPath }}\nCarpeta backups: {{ $('Parsear ruta ZIP').item.json.backupDir }}\nRetención: {{ $('Parsear ruta ZIP').item.json.daysToKeep }} días\nHora: {{ $('Parsear ruta ZIP').item.json.ahora }}\n\nRotación:\n{{ $json.stdout || $json }}\n\nGoogle Drive: {{ $('Subir a Google Drive').isExecuted ? ($('Subir a Google Drive').item.json.webViewLink || ('https://drive.google.com/open?id=' + $('Subir a Google Drive').item.json.id)) : 'no ejecutado — conecta Parsear → Leer ZIP → Drive → Rotacion (y activa el nodo Drive)' }}",
        "options": {}
      },
      "id": "gmail-backup-001",
      "name": "Gmail backup OK",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1540, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR_ID_CREDENCIAL",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Schedule 03:00": {
      "main": [[{ "node": "Rutas backup", "type": "main", "index": 0 }]]
    },
    "Rutas backup": {
      "main": [[{ "node": "Crear ZIP", "type": "main", "index": 0 }]]
    },
    "Crear ZIP": {
      "main": [[{ "node": "Parsear ruta ZIP", "type": "main", "index": 0 }]]
    },
    "Parsear ruta ZIP": {
      "main": [[{ "node": "Leer ZIP disco", "type": "main", "index": 0 }]]
    },
    "Leer ZIP disco": {
      "main": [[{ "node": "Subir a Google Drive", "type": "main", "index": 0 }]]
    },
    "Subir a Google Drive": {
      "main": [[{ "node": "Rotacion +7 dias", "type": "main", "index": 0 }]]
    },
    "Rotacion +7 dias": {
      "main": [[{ "node": "Gmail backup OK", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [],
  "triggerCount": 1
}
